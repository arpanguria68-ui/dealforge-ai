# ─── LLM API Keys ───────────────────────────────────────────────────
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# ─── Financial Data API Keys ─────────────────────────────────────────
FMP_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINANCIAL_DATASETS_API_KEY=

# ─── SEC Filing Due Diligence (optional — free EDGAR used by default) ─
# Get a free key at: https://sec-api.io (100 req/month free)
SEC_API_KEY=

# ─── App Configuration ───────────────────────────────────────────────
DEBUG=false
DEFAULT_LLM_PROVIDER=gemini
PAGEINDEX_MODE=local

# ─── Model Selection (optional overrides) ────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
MISTRAL_MODEL=mistral-large-latest
OPENAI_MODEL=gpt-4o

# ─── Security (set these before exposing the stack beyond localhost) ──
# Enforce a bearer token on admin/sensitive endpoints (settings, reports,
# template merge, knowledge ingest). The UI sends VITE_ADMIN_API_TOKEN, which
# is visible in the browser bundle: this blocks direct API abuse, it is not
# per-user authentication.
ADMIN_API_TOKEN=
REQUIRE_ADMIN_TOKEN=true
# Server paths that directory import / template merge may touch
# (os.pathsep-separated; default: DATA_DIR and REPORTS_DIR). Enforced
# automatically inside containers.
SERVER_PATH_ROOTS=

# ─── Knowledge graph / Laya ───────────────────────────────────────────
KG_BACKEND=sqlite         # sqlite | neo4j | off
LAYA_WARMUP=true          # load Laya checkpoints in the background at startup
