# ─── LLM API Keys ───────────────────────────────────────────────────
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# ─── Financial Data API Keys ─────────────────────────────────────────
FMP_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINANCIAL_DATASETS_API_KEY=

# ─── SEC Filing Due Diligence (optional — free EDGAR used by default) ─
# Get a free key at: https://sec-api.io (100 req/month free)
SEC_API_KEY=

# ─── App Configuration ───────────────────────────────────────────────
DEBUG=false
DEFAULT_LLM_PROVIDER=gemini
PAGEINDEX_MODE=local

# ─── Model Selection (optional overrides) ────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
MISTRAL_MODEL=mistral-large-latest
OPENAI_MODEL=gpt-4o
