# DealForge AI Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dealforge
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production
ADMIN_API_TOKEN=replace-with-strong-admin-token
REQUIRE_ADMIN_TOKEN=false

# OpenAI / Codex
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
CODEX_MODEL=gpt-5.1-codex-max

# OpenRouter (OpenAI-compatible gateway; model IDs use provider/model format)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Mistral
MISTRAL_API_KEY=...
MISTRAL_MODEL=mistral-large-latest

# Gemini
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-pro

# NVIDIA
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm5

# Local LM Studio; reasoning is disabled by default to preserve answer tokens.
# Use "on" for models/tasks that benefit from longer internal reasoning.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model
LMSTUDIO_REASONING=off

# Vertex AI / Google Cloud
VERTEX_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-1.5-flash-002
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Search APIs
SERPER_API_KEY=
SEARXNG_INSTANCE_URL=
SEARXNG_API_KEY=

# PageIndex (VectifyAI)
PAGEINDEX_API_KEY=...
PAGEINDEX_BASE_URL=https://api.vectify.ai/v1

# Agent Settings
MAX_AGENT_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=300

# Frontend (Vite)
VITE_API_BASE=http://localhost:8005
VITE_ADMIN_API_TOKEN=replace-with-strong-admin-token

# Comma-separated exact browser origins allowed to call the API.
# Set production domains explicitly; do not use a wildcard.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Deal Scoring
DEAL_SCORING_THRESHOLD=0.65

# ── Laya System-1 decision layer (optional, fail-soft when uninstalled) ──
# pip install "laya[langchain]" for local inference, or point at laya-serve.
LAYA_ENABLED=true
LAYA_MODE=auto            # auto | local | remote | lmstudio | off
LAYA_BASE_URL=            # e.g. http://laya-service:8000 (remote mode)
LAYA_REMOTE_PATH=/v1/systemone  # endpoint path; use /api/evaluate for OpenJev-compatible APIs
LAYA_LMSTUDIO_URL=        # LM Studio override (default: LMSTUDIO_BASE_URL / settings)
LAYA_LMSTUDIO_MODEL=      # LM Studio model override (default: LMSTUDIO_MODEL / settings)
LAYA_LMSTUDIO_TIMEOUT=120
LAYA_API_KEY=
LAYA_MODEL=               # override checkpoint: english | multilingual | typed-decisions
LAYA_PRELOAD=false        # true on servers: preload all checkpoints once
LAYA_TIMEOUT_SECONDS=8
LAYA_FAST_POOL=groq,gemini,mistral           # simple tasks: cheapest fast cloud
LAYA_GENERAL_POOL=gemini,openai,openrouter,mistral,nvidia,vertex
LAYA_REASONING_POOL=vertex,claude,openai,openrouter,gemini  # complex tasks

# ── RAG v2 tuning ──
RAG_DENSE=true            # dense cosine via sentence-transformers (falls back to hashed TF-IDF)
RAG_EMBED_MODEL=all-MiniLM-L6-v2
RAG_LAYA_RERANK=true      # Laya System-1 rerank of fused shortlist
RAG_RERANK_N=30
RAG_W_TREE=0.4
RAG_W_BM25=0.3
RAG_W_DENSE=0.3
ROUTER_HEALTH_TTL=60      # seconds to cache local-LLM health probes

# ── External Model Context Protocol servers (Streamable HTTP, opt-in) ──
# Only tools marked readOnlyHint=true are exposed. Every server must declare
# allowed_agents and tool_families per remote tool; credentials belong in env.
# Example: MCP_SERVERS_JSON=[{"id":"research","url":"http://localhost:9000/mcp","headers_env":{"Authorization":"RESEARCH_MCP_AUTH"},"allowed_agents":["market_researcher"],"tool_families":{"search_company":"search"}}]
MCP_SERVERS_JSON=[]
# RESEARCH_MCP_AUTH=Bearer replace-with-token

# ─── Server path confinement / knowledge graph ───────────────────────
SERVER_PATH_ROOTS=        # os.pathsep-separated; default DATA_DIR + REPORTS_DIR
SERVER_PATH_RESTRICT=     # true|false; default true in containers, false locally
KG_BACKEND=sqlite         # sqlite | neo4j | off
LAYA_WARMUP=true
TOOL_LLM_EXTRACTION=true  # quote-verified LLM extraction in text-reading tools
